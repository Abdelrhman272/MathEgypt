<odoo>
    <record id="view_agri_crop_list" model="ir.ui.view">
        <field name="name">agri.crop.list</field>
        <field name="model">agri.crop</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="code"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_agri_crop_form" model="ir.ui.view">
        <field name="name">agri.crop.form</field>
        <field name="model">agri.crop</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="code"/>
                        <field name="active"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
</odoo>
