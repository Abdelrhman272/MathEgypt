<odoo>
    <record id="view_agri_eval_list" model="ir.ui.view">
        <field name="name">agri.farm.evaluation.list</field>
        <field name="model">agri.farm.evaluation</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="evaluation_date"/>
                <field name="farm_id"/>
                <field name="crop_id"/>
                <field name="state"/>
                <field name="purchase_id"/>
            </list>
        </field>
    </record>

    <record id="view_agri_eval_form" model="ir.ui.view">
        <field name="name">agri.farm.evaluation.form</field>
        <field name="model">agri.farm.evaluation</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_create_purchase" type="object" string="Create PO" class="btn-primary"
                            attrs="{'invisible':[('purchase_id','!=',False)]}"/>
                    <button name="action_open_purchase" type="object" string="Open PO"
                            attrs="{'invisible':[('purchase_id','=',False)]}"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,confirmed,cancelled"/>
                </header>

                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button type="object" name="action_open_production" class="oe_stat_button" icon="fa-industry">
                            <field name="production_count" widget="statinfo" string="Batches"/>
                        </button>
                        <button type="object" name="action_open_shipments" class="oe_stat_button" icon="fa-ship">
                            <field name="shipment_count" widget="statinfo" string="Shipments"/>
                        </button>
                    </div>

                    <group>
                        <field name="name" readonly="1"/>
                        <field name="evaluation_date"/>
                        <field name="farm_id"/>
                        <field name="crop_id"/>
                    </group>

                    <group string="Expected">
                        <field name="expected_qty"/>
                        <field name="expected_uom_id"/>
                    </group>

                    <group string="Purchase Proposal">
                        <field name="supplier_id"/>
                        <field name="purchase_product_id"/>
                        <field name="purchase_qty"/>
                        <field name="purchase_uom_id"/>
                        <field name="purchase_price_unit"/>
                        <field name="purchase_id" readonly="1"/>
                    </group>

                    <group>
                        <field name="note"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_agri_eval" model="ir.actions.act_window">
        <field name="name">Evaluations</field>
        <field name="res_model">agri.farm.evaluation</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
