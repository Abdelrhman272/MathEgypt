<odoo>
    <record id="view_agri_prod_list" model="ir.ui.view">
        <field name="name">agri.production.batch.list</field>
        <field name="model">agri.production.batch</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="evaluation_id"/>
                <field name="raw_lot_id"/>
                <field name="expected_qty"/>
                <field name="actual_output_qty"/>
                <field name="variance_qty"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <record id="view_agri_prod_form" model="ir.ui.view">
        <field name="name">agri.production.batch.form</field>
        <field name="model">agri.production.batch</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name" readonly="1"/>
                        <field name="evaluation_id"/>
                        <field name="raw_lot_id"/>
                        <field name="state"/>
                    </group>
                    <group>
                        <field name="expected_qty"/>
                        <field name="actual_output_qty" readonly="1"/>
                        <field name="variance_qty" readonly="1"/>
                    </group>

                    <notebook>
                        <page string="Outputs">
                            <field name="output_line_ids">
                                <list editable="bottom">
                                    <field name="product_id"/>
                                    <field name="lot_id"/>
                                    <field name="qty"/>
                                    <field name="uom_id"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_agri_prod" model="ir.actions.act_window">
        <field name="name">Production</field>
        <field name="res_model">agri.production.batch</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
