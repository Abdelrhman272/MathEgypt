<odoo>
    <record id="view_agri_farm_list" model="ir.ui.view">
        <field name="name">agri.farm.list</field>
        <field name="model">agri.farm</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="partner_id"/>
                <field name="country_id"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_agri_farm_form" model="ir.ui.view">
        <field name="name">agri.farm.form</field>
        <field name="model">agri.farm</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="partner_id"/>
                        <field name="country_id"/>
                        <field name="active"/>
                    </group>
                    <group>
                        <field name="note"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_agri_farm" model="ir.actions.act_window">
        <field name="name">Farms</field>
        <field name="res_model">agri.farm</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
