<odoo>
    <record id="view_agri_ship_list" model="ir.ui.view">
        <field name="name">agri.export.shipment.list</field>
        <field name="model">agri.export.shipment</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="container_no"/>
                <field name="sale_order_id"/>
                <field name="invoice_id"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <record id="view_agri_ship_form" model="ir.ui.view">
        <field name="name">agri.export.shipment.form</field>
        <field name="model">agri.export.shipment</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <field name="state" widget="statusbar" statusbar_visible="draft,shipped,invoiced"/>
                </header>
                <sheet>
                    <group>
                        <field name="name" readonly="1"/>
                        <field name="container_no"/>
                    </group>
                    <group>
                        <field name="sale_order_id"/>
                        <field name="invoice_id"/>
                    </group>
                    <group>
                        <field name="lot_ids" widget="many2many_tags"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_agri_ship" model="ir.actions.act_window">
        <field name="name">Shipments</field>
        <field name="res_model">agri.export.shipment</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
