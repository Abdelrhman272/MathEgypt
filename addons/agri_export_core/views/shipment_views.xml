<odoo>
    <record id="view_agri_ship_list" model="ir.ui.view">
        <field name="name">agri.export.shipment.list</field>
        <field name="model">agri.export.shipment</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="container_no"/>
                <field name="customer_id"/>
                <field name="sale_order_id"/>
                <field name="picking_id"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <record id="view_agri_ship_form" model="ir.ui.view">
        <field name="name">agri.export.shipment.form</field>
        <field name="model">agri.export.shipment</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_create_sale_order" type="object" string="Create SO" class="btn-primary"
                            attrs="{'invisible':[('sale_order_id','!=',False)]}"/>
                    <button name="action_open_sale" type="object" string="Open SO"
                            attrs="{'invisible':[('sale_order_id','=',False)]}"/>

                    <button name="action_create_delivery" type="object" string="Create Delivery"
                            class="btn-primary"
                            attrs="{'invisible':[('picking_id','!=',False)]}"/>
                    <button name="action_open_picking" type="object" string="Open Delivery"
                            attrs="{'invisible':[('picking_id','=',False)]}"/>

                    <field name="state" widget="statusbar" statusbar_visible="draft,reserved,shipped,invoiced"/>
                </header>

                <sheet>
                    <group>
                        <field name="name" readonly="1"/>
                        <field name="container_no"/>
                        <field name="evaluation_id"/>
                    </group>

                    <group string="Customer & Container Sale">
                        <field name="customer_id"/>
                        <field name="container_product_id"/>
                        <field name="container_qty"/>
                        <field name="sale_order_id" readonly="1"/>
                        <field name="invoice_id" readonly="1"/>
                    </group>

                    <group string="Delivery">
                        <field name="picking_id" readonly="1"/>
                    </group>

                    <notebook>
                        <page string="Lot Reservations">
                            <field name="reservation_line_ids">
                                <list editable="bottom">
                                    <field name="lot_id"/>
                                    <field name="product_id" readonly="1"/>
                                    <field name="qty"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_agri_ship" model="ir.actions.act_window">
        <field name="name">Shipments</field>
        <field name="res_model">agri.export.shipment</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
