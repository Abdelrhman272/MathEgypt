<odoo>
    <!-- Custom group -->
    <record id="group_agri_user" model="res.groups">
        <field name="name">Agri Export User</field>
        <field name="category_id" ref="base.module_category_inventory"/>
    </record>

    <!-- ✅ Important: grant this group to ALL internal users -->
    <record id="base.group_user" model="res.groups">
        <field name="implied_ids" eval="[(4, ref('agri_export_core.group_agri_user'))]"/>
    </record>
</odoo>
