<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_export_shipment_tree_inherit_costing" model="ir.ui.view">
        <field name="name">export.shipment.list.costing</field>
        <field name="model">export.shipment</field>
        <field name="inherit_id" ref="export_shipment.view_export_shipment_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//list/field[@name='total_qty']" position="after">
                <field name="costing_status" optional="show"/>
                <field name="logistics_total_cost" optional="show"/>
                <field name="revenue_amount" optional="show"/>
                <field name="gross_profit_amount" optional="show"/>
                <field name="gross_margin_pct" optional="show"/>
                <field name="actual_logistics_total_cost" optional="hide"/>
                <field name="manual_logistics_total_cost" optional="hide"/>
            </xpath>
        </field>
    </record>

    <record id="view_export_shipment_form_inherit_costing" model="ir.ui.view">
        <field name="name">export.shipment.form.costing</field>
        <field name="model">export.shipment</field>
        <field name="inherit_id" ref="export_shipment.view_export_shipment_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet/group/group/field[@name='container_no']" position="after">
                <field name="container_count"/>
            </xpath>

            <xpath expr="//notebook" position="replace">
                <notebook>
                    <page string="Products">
                        <field name="line_ids">
                            <list editable="bottom">
                                <field name="product_id"/>
                                <field name="product_uom_id" readonly="1"/>
                                <field name="product_uom_qty"/>
                                <field name="carton_qty" optional="show"/>
                                <field name="net_weight" optional="show"/>
                                <field name="gross_weight" optional="show"/>
                                <field name="allocated_logistics_cost" readonly="1" optional="hide"/>
                                <field name="logistics_cost_per_carton" readonly="1" optional="hide"/>
                                <field name="logistics_cost_per_qty" readonly="1" optional="hide"/>
                            </list>
                        </field>
                    </page>

                    <page string="Reserved Lots">
                        <field name="lot_line_ids">
                            <list editable="bottom">
                                <field name="line_id" domain="[('shipment_id', '=', parent.id)]"/>
                                <field name="product_id" readonly="1"/>
                                <field name="lot_id"/>
                                <field name="qty"/>
                            </list>
                        </field>
                        <div class="text-muted">
                            Reserve Lots will create an outgoing picking and reserve the selected lots.
                            This will reflect in Inventory as outgoing quantities and reduce free-to-use stock.
                        </div>
                    </page>

                    <page string="Profitability">
                        <group>
                            <group>
                                <field name="costing_status" readonly="1"/>
                                <field name="logistics_total_cost" readonly="1"/>
                                <field name="manual_logistics_total_cost" readonly="1"/>
                                <field name="actual_logistics_total_cost" readonly="1"/>
                            </group>
                            <group>
                                <field name="logistics_cost_per_container" readonly="1"/>
                                <field name="revenue_amount" readonly="1"/>
                                <field name="gross_profit_amount" readonly="1"/>
                                <field name="gross_margin_pct" readonly="1"/>
                            </group>
                        </group>
                    </page>

                    <page string="Logistics Costs">
                        <field name="logistics_cost_line_ids">
                            <list editable="bottom">
                                <field name="sequence" widget="handle"/>
                                <field name="name"/>
                                <field name="cost_type"/>
                                <field name="allocation_basis"/>
                                <field name="cost_source_type"/>
                                <field name="effective_amount" readonly="1" optional="show"/>
                                <field name="amount" optional="hide"/>
                                <field name="source_amount" readonly="1" optional="hide"/>
                                <field name="vendor_bill_id" optional="hide"/>
                                <field name="vendor_bill_line_id" optional="hide"/>
                                <field name="landed_cost_id" optional="hide"/>
                                <field name="note" optional="hide"/>
                            </list>
                            <form string="Logistics Cost Line">
                                <group>
                                    <group>
                                        <field name="name"/>
                                        <field name="cost_type"/>
                                        <field name="allocation_basis"/>
                                        <field name="cost_source_type"/>
                                    </group>
                                    <group>
                                        <field name="amount" invisible="cost_source_type != 'manual'"/>
                                        <field name="source_amount" readonly="1"/>
                                        <field name="effective_amount" readonly="1"/>
                                        <field name="note"/>
                                    </group>
                                </group>
                                <group string="Actual Cost Source">
                                    <group>
                                        <field name="vendor_bill_id"
                                               invisible="cost_source_type not in ['vendor_bill', 'vendor_bill_line']"
                                               domain="[('move_type','in',['in_invoice','in_refund']),('company_id','=',parent.company_id)]"/>
                                        <field name="vendor_bill_line_id"
                                               invisible="cost_source_type != 'vendor_bill_line'"
                                               domain="[('move_id','=',vendor_bill_id),('display_type','=',False)]"/>
                                        <field name="landed_cost_id"
                                               invisible="cost_source_type != 'landed_cost'"
                                               domain="[('company_id','=',parent.company_id)]"/>
                                    </group>
                                </group>
                            </form>
                        </field>
                        <div class="text-muted">
                            Add inland transport, port, freight, customs, and other shipment costs here.
                            Use actual sources when available and keep manual entry only as a fallback.
                        </div>
                    </page>

                    <page string="Allocation Review">
                        <field name="line_ids" readonly="1">
                            <list>
                                <field name="product_id"/>
                                <field name="product_uom_qty"/>
                                <field name="carton_qty" optional="show"/>
                                <field name="net_weight" optional="show"/>
                                <field name="gross_weight" optional="show"/>
                                <field name="allocated_logistics_cost" readonly="1" optional="show"/>
                                <field name="logistics_cost_per_carton" readonly="1" optional="show"/>
                                <field name="logistics_cost_per_qty" readonly="1" optional="show"/>
                            </list>
                        </field>
                    </page>
                </notebook>
            </xpath>
        </field>
    </record>

</odoo>
