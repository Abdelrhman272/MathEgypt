<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Paperformat A4 Landscape -->
    <record id="paperformat_lot_traceability_a4_landscape" model="report.paperformat">
        <field name="name">Lot Traceability - A4 Landscape</field>
        <field name="format">A4</field>
        <field name="orientation">Landscape</field>
        <field name="margin_top">10</field>
        <field name="margin_bottom">10</field>
        <field name="margin_left">10</field>
        <field name="margin_right">10</field>
        <field name="header_line" eval="False"/>
        <field name="header_spacing">8</field>
        <field name="dpi">90</field>
    </record>

    <!-- PDF Report Action (على الـ Wizard نفسه) -->
    <record id="action_report_lot_traceability" model="ir.actions.report">
        <field name="name">Lot Traceability Report</field>
        <field name="model">lot.traceability.wizard</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">export_shipment.lot_traceability_report_template</field>
        <field name="report_file">export_shipment.lot_traceability_report_template</field>
        <field name="paperformat_id" ref="export_shipment.paperformat_lot_traceability_a4_landscape"/>
        <field name="print_report_name">'Traceability - %s' % (object.invoice_id.name or '')</field>
    </record>

</odoo>
