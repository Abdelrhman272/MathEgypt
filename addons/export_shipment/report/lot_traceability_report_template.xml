<?xml version="1.0" encoding="utf-8"?>
<odoo>

  <template id="lot_traceability_report_template">
    <t t-call="web.external_layout">
      <t t-set="doc" t-value="docs[0]"/>
      <main class="o_main">

        <div class="row mb-2">
          <div class="col-8">
            <h2 style="margin:0;">Lot Traceability Report</h2>

            <div style="font-size:12px;">
              <strong>Invoice:</strong>&#160;<span t-esc="doc.invoice_id.name or ''"/>
            </div>
            <div style="font-size:12px;">
              <strong>Customer:</strong>&#160;<span t-esc="doc.invoice_id.partner_id.display_name or ''"/>
            </div>
            <div style="font-size:12px;">
              <strong>Shipments:</strong>&#160;
              <span t-esc="', '.join(doc.shipment_ids.mapped('name')) if doc.shipment_ids else ''"/>
            </div>
            <div style="font-size:12px;">
              <strong>Lines Count:</strong>&#160;<span t-esc="len(doc.line_ids)"/>
            </div>
            <div style="font-size:12px;">
              <strong>Moves Count:</strong>&#160;<span t-esc="doc.moves_count"/>
            </div>
          </div>

          <div class="col-4 text-end" style="font-size:12px;">
            <strong>Date:</strong>&#160;<span t-esc="time.strftime('%Y-%m-%d')"/>
          </div>
        </div>

        <table class="table table-sm table-bordered" style="font-size:11px;">
          <thead>
            <tr>
              <th style="width:10%;">Delivery Date</th>
              <th style="width:10%;">Delivery Picking</th>
              <th style="width:10%;">Finished Product</th>
              <th style="width:10%;">Finished Lot</th>
              <th style="width:10%;">Production</th>
              <th style="width:10%;">Production Date</th>
              <th style="width:15%;">Raw Lots</th>
              <th style="width:10%;">Vendors</th>
              <th style="width:10%;">Receipts</th>
              <th style="width:10%;">Receipt Date</th>
            </tr>
          </thead>

          <tbody>
            <t t-foreach="doc.line_ids" t-as="ln">
              <tr>
                <!-- Delivery Date -->
                <td>
                  <span t-esc="ln.delivery_date and ln.delivery_date.strftime('%Y-%m-%d %H:%M:%S') or ''"/>
                </td>

                <!-- Delivery Picking -->
                <td><span t-esc="ln.delivery_picking or ''"/></td>

                <!-- Finished Product -->
                <td><span t-esc="ln.finished_product or ''"/></td>

                <!-- Finished Lot -->
                <td><span t-esc="ln.finished_lot or ''"/></td>

                <!-- Production -->
                <td><span t-esc="ln.production or ''"/></td>

                <!-- Production Date -->
                <td>
                  <span t-esc="ln.production_date and ln.production_date.strftime('%Y-%m-%d %H:%M:%S') or ''"/>
                </td>

                <!-- Raw Lots -->
                <td><span t-esc="ln.raw_lots or ''"/></td>

                <!-- Vendors -->
                <td><span t-esc="ln.vendors or ''"/></td>

                <!-- Receipts -->
                <td><span t-esc="ln.receipts or ''"/></td>

                <!-- Receipt Date -->
                <td>
                  <span t-esc="ln.receipt_date and ln.receipt_date.strftime('%Y-%m-%d %H:%M:%S') or ''"/>
                </td>
              </tr>
            </t>

            <tr t-if="not doc.line_ids">
              <td colspan="10" class="text-center">No traceability lines found</td>
            </tr>
          </tbody>
        </table>

      </main>
    </t>
  </template>

</odoo>
