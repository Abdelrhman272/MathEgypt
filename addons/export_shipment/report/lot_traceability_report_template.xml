<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="report_lot_traceability_pdf">
        <t t-call="web.external_layout">
            <main class="o_main">

                <t t-foreach="docs" t-as="wiz">
                    <div class="page">

                        <div class="row mb-2">
                            <div class="col-8">
                                <h2 style="margin:0;">Lot Traceability Report</h2>
                                <div style="font-size:12px;">
                                    <strong>Invoice:</strong>
                                    <span t-esc="wiz.invoice_id.name or ''"/>
                                </div>
                                <div style="font-size:12px;">
                                    <strong>Customer:</strong>
                                    <span t-esc="wiz.invoice_id.partner_id.display_name if wiz.invoice_id.partner_id else ''"/>
                                </div>
                                <div style="font-size:12px;">
                                    <strong>Lots Count:</strong>
                                    <span t-esc="len(wiz.lot_ids)"/> <span>|</span>
                                    <strong>Moves:</strong>
                                    <span t-esc="wiz.move_line_count or 0"/>
                                </div>
                            </div>
                            <div class="col-4 text-end" style="font-size:12px;">
                                <strong>Date:</strong>
                                <span t-esc="wiz.invoice_id.invoice_date or ''"/>
                            </div>
                        </div>

                        <table class="table table-sm table-bordered" style="font-size:11px;">
                            <thead>
                                <tr>
                                    <th style="width:10%;">Date</th>
                                    <th style="width:10%;">Lot</th>
                                    <th>Product</th>
                                    <th style="width:8%;" class="text-end">Qty</th>
                                    <th style="width:8%;">UoM</th>
                                    <th style="width:10%;">Picking</th>
                                    <th style="width:8%;">Type</th>
                                    <th style="width:12%;">Partner</th>
                                    <th style="width:12%;">From</th>
                                    <th style="width:12%;">To</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-set="lines" t-value="wiz._get_trace_move_lines()"/>
                                <t t-foreach="lines" t-as="ml">
                                    <tr>
                                        <td><span t-esc="ml.date or ''"/></td>
                                        <td><span t-esc="ml.lot_id.name or ''"/></td>
                                        <td><span t-esc="ml.product_id.display_name or ''"/></td>
                                        <td class="text-end"><span t-esc="ml.qty_done or 0.0"/></td>
                                        <td><span t-esc="ml.product_uom_id.name or ''"/></td>
                                        <td><span t-esc="ml.picking_id.name if ml.picking_id else ''"/></td>
                                        <td><span t-esc="ml.picking_id.picking_type_id.code if ml.picking_id and ml.picking_id.picking_type_id else ''"/></td>
                                        <td><span t-esc="ml.picking_id.partner_id.display_name if ml.picking_id and ml.picking_id.partner_id else ''"/></td>
                                        <td><span t-esc="ml.location_id.display_name or ''"/></td>
                                        <td><span t-esc="ml.location_dest_id.display_name or ''"/></td>
                                    </tr>
                                </t>

                                <tr t-if="not lines">
                                    <td colspan="10" class="text-center">No traceability lines found.</td>
                                </tr>
                            </tbody>
                        </table>

                    </div>
                </t>

            </main>
        </t>
    </template>

</odoo>
