<?xml version="1.0" encoding="utf-8"?>
<odoo>

  <record id="view_export_shipment_form_inherit_print" model="ir.ui.view">
    <field name="name">export.shipment.form.inherit.print</field>
    <field name="model">export.shipment</field>
    <field name="inherit_id" ref="export_shipment.view_export_shipment_form"/>
    <field name="arch" type="xml">

      <!-- Add Print button in header -->
      <xpath expr="//header" position="inside">
        <button
          name="%(export_shipment.action_report_export_shipment)d"
          type="action"
          string="Print"
          class="btn-secondary"
          attrs="{'invisible': [('id', '=', False)]}"
        />
      </xpath>

    </field>
  </record>

</odoo>
