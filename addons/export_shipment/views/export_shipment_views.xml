<?xml version="1.0" encoding="utf-8"?>
<odoo>

  <!-- =========================================================
       Export Shipment Views
       ========================================================= -->

  <record id="view_export_shipment_tree" model="ir.ui.view">
    <field name="name">export.shipment.list</field>
    <field name="model">export.shipment</field>
    <field name="arch" type="xml">
      <list>
        <field name="name"/>
        <field name="partner_id"/>
        <field name="container_no"/>
        <field name="destination"/>
        <field name="state"/>
        <field name="total_qty"/>
      </list>
    </field>
  </record>

  <record id="view_export_shipment_form" model="ir.ui.view">
    <field name="name">export.shipment.form</field>
    <field name="model">export.shipment</field>
    <field name="arch" type="xml">
      <form string="Export Shipment">
        <header>
          <field name="state" widget="statusbar" statusbar_visible="draft,reserved,shipped,cancel"/>

          <button name="action_reserve_lots" type="object" string="Reserve Lots"
                  class="btn-primary" invisible="state != 'draft'"/>

          <button name="action_unreserve" type="object" string="Unreserve"
                  class="btn-secondary" invisible="state != 'reserved'"/>

          <button name="action_create_sale_order" type="object" string="Create Sale Order"
                  class="btn-secondary" invisible="sale_order_id != False"/>

          <button name="action_update_sale_line_description" type="object" string="Update SO Description"
                  class="btn-secondary" invisible="sale_order_id == False"/>

          <button name="action_validate_shipment" type="object" string="Validate Shipment"
                  class="btn-primary" invisible="state != 'reserved'"/>

          <button name="action_cancel" type="object" string="Cancel"
                  class="btn-danger" invisible="state == 'cancel'"/>

          <button name="action_reset_to_draft" type="object" string="Reset to Draft"
                  class="btn-secondary" invisible="state != 'cancel'"/>
        </header>

        <sheet>
          <group>
            <group>
              <field name="name" readonly="1"/>
              <field name="company_id"/>
              <field name="partner_id"/>
            </group>
            <group>
              <field name="container_no"/>
              <field name="seal_no"/>
              <field name="destination"/>
              <field name="sale_order_id" readonly="1"/>
              <field name="reserved_picking_id" readonly="1"/>
            </group>
          </group>

          <notebook>
            <page string="Products">
              <field name="line_ids">
                <list editable="bottom">
                  <field name="product_id"/>
                  <field name="product_uom_id" readonly="1"/> <!-- CHANGED -->
                  <field name="product_uom_qty"/>
                </list>
              </field>
            </page>

            <page string="Reserved Lots">
              <field name="lot_line_ids">
                <list editable="bottom">
                  <!-- CHANGED: restrict line_id to same shipment lines -->
                  <field name="line_id" domain="[('shipment_id', '=', shipment_id)]"/>
                  <field name="product_id" readonly="1"/>
                  <field name="lot_id"/>
                  <field name="qty"/>
                </list>
              </field>
              <div class="text-muted">
                Reserve Lots will create an outgoing picking and reserve the selected lots.
                This will reflect in Inventory as outgoing quantities and reduce free-to-use stock.
              </div>
            </page>
          </notebook>
        </sheet>
      </form>
    </field>
  </record>

  <record id="action_export_shipment" model="ir.actions.act_window">
    <field name="name">Export Shipments</field>
    <field name="res_model">export.shipment</field>
    <field name="view_mode">list,form</field>
  </record>

  <!-- Default service product for container booking (SO line) -->
  <record id="product_tmpl_export_container_service" model="product.template">
    <field name="name">Export Container Service</field>
    <field name="type">service</field>
    <field name="sale_ok">True</field>
    <field name="purchase_ok">False</field>
  </record>

  <!-- Show Export Shipment link on Sale Order -->
  <record id="view_sale_order_form_inherit_export_shipment" model="ir.ui.view">
    <field name="name">sale.order.form.inherit.export.shipment</field>
    <field name="model">sale.order</field>
    <field name="inherit_id" ref="sale.view_order_form"/>
    <field name="arch" type="xml">
      <xpath expr="//sheet//group//field[@name='partner_id']" position="after">
        <field name="export_shipment_id" readonly="1" invisible="export_shipment_id == False"/>
      </xpath>
    </field>
  </record>

  <!-- =========================================================
       Export & Logistics Settings (Dedicated model - stable)
       Model: export.logistics.settings
       ========================================================= -->

  <record id="view_export_logistics_settings_form" model="ir.ui.view">
    <field name="name">export.logistics.settings.form</field>
    <field name="model">export.logistics.settings</field>
    <field name="arch" type="xml">
      <form string="Export &amp; Logistics">
        <sheet>
          <group>
            <field name="company_id" readonly="1"/>
          </group>

          <group string="Export &amp; Logistics">
            <field name="container_product_tmpl_id"/>
            <field name="container_line_prefix"/>
            <field name="auto_lot"/>
          </group>

          <div class="text-muted">
            These settings are used by the Export Shipment workflow.
          </div>
        </sheet>
      </form>
    </field>
  </record>

  <record id="action_export_logistics_settings" model="ir.actions.act_window">
    <field name="name">Export &amp; Logistics</field>
    <field name="res_model">export.logistics.settings</field>
    <field name="view_mode">form</field>
    <field name="target">current</field>
    <field name="context">{}</field>
  </record>

</odoo>
