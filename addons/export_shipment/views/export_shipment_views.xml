<?xml version="1.0" encoding="utf-8"?>
<odoo>

  <record id="view_export_shipment_tree" model="ir.ui.view">
    <field name="name">export.shipment.list</field>
    <field name="model">export.shipment</field>
    <field name="arch" type="xml">
      <list>
        <field name="name"/>
        <field name="partner_id"/>
        <field name="container_no"/>
        <field name="state"/>
        <field name="total_qty"/>
      </list>
    </field>
  </record>

  <record id="view_export_shipment_form" model="ir.ui.view">
    <field name="name">export.shipment.form</field>
    <field name="model">export.shipment</field>
    <field name="arch" type="xml">
      <form string="Export Shipment">
        <header>
          <field name="state" widget="statusbar" statusbar_visible="draft,reserved,shipped,cancel"/>
          <button name="action_reserve_lots" type="object" string="Reserve Lots"
                  class="btn-primary" invisible="state != 'draft'"/>
          <button name="action_unreserve" type="object" string="Unreserve"
                  class="btn-secondary" invisible="state != 'reserved'"/>
          <button name="action_create_sale_order" type="object" string="Create Sale Order"
                  class="btn-secondary" invisible="sale_order_id != False"/>
          <button name="action_validate_shipment" type="object" string="Validate Shipment"
                  class="btn-primary" invisible="state != 'reserved'"/>
          <button name="action_cancel" type="object" string="Cancel"
                  class="btn-danger" invisible="state == 'cancel'"/>
          <button name="action_reset_to_draft" type="object" string="Reset to Draft"
                  class="btn-secondary" invisible="state != 'cancel'"/>
        </header>

        <sheet>
          <group>
            <group>
              <field name="name" readonly="1"/>
              <field name="company_id"/>
              <field name="partner_id"/>
              <field name="destination"/>
            </group>
            <group>
              <field name="container_no"/>
              <field name="seal_no"/>
              <field name="sale_order_id" readonly="1"/>
              <field name="reserved_picking_id" readonly="1"/>
            </group>
          </group>

          <notebook>
            <page string="Lines">
              <field name="line_ids">
                <list editable="bottom">
                  <field name="product_id"/>
                  <field name="bom_id" readonly="1"/>
                  <field name="product_uom_qty"/>
                  <field name="product_uom_id"/>
                </list>
              </field>
            </page>

            <page string="Reserved Lots">
              <field name="lot_line_ids">
                <list editable="bottom">
                  <field name="line_id"/>
                  <field name="product_id" readonly="1"/>
                  <field name="lot_id"/>
                  <field name="qty"/>
                  <field name="product_uom_id" readonly="1"/>
                </list>
              </field>
              <label string="Tip: Add reserved lots for each line, then click 'Reserve Lots' to lock stock (reduces Free to Use)."/>
            </page>
          </notebook>
        </sheet>
      </form>
    </field>
  </record>

  <record id="action_export_shipment" model="ir.actions.act_window">
    <field name="name">Export Shipments</field>
    <field name="res_model">export.shipment</field>
    <field name="view_mode">list,form</field>
  </record>

</odoo>
