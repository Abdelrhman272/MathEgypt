<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Wizard Form -->
    <record id="lot_traceability_wizard_form_view" model="ir.ui.view">
        <field name="name">lot.traceability.wizard.form</field>
        <field name="model">lot.traceability.wizard</field>
        <field name="arch" type="xml">
            <form string="Traceability Report">
                <group>
                    <field name="invoice_id" readonly="1"/>
                    <field name="lot_ids" widget="many2many_tags" placeholder="(Optional) filter lots manually"/>
                    <field name="moves_count" readonly="1"/>
                </group>

                <footer>
                    <button name="action_open_screen" type="object" string="Open Screen" class="btn-primary"/>
                    <button name="action_download_pdf" type="object" string="Download PDF" class="btn-secondary"/>
                    <button name="action_download_excel" type="object" string="Download Excel" class="btn-secondary"/>
                    <button string="Close" class="btn-link" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- Lines Tree -->
    <record id="lot_traceability_line_tree_view" model="ir.ui.view">
        <field name="name">lot.traceability.line.tree</field>
        <field name="model">lot.traceability.line</field>
        <field name="arch" type="xml">
            <tree string="Lot Traceability Lines" create="0" edit="0" delete="0">
                <field name="date"/>
                <field name="lot_id"/>
                <field name="product_id"/>
                <field name="qty"/>
                <field name="uom_id"/>
                <field name="picking_id"/>
                <field name="picking_type_code"/>
                <field name="partner_id"/>
                <field name="location_from_id"/>
                <field name="location_to_id"/>
                <field name="origin_ref"/>
                <field name="production_id"/>
            </tree>
        </field>
    </record>

    <!-- Lines Form -->
    <record id="lot_traceability_line_form_view" model="ir.ui.view">
        <field name="name">lot.traceability.line.form</field>
        <field name="model">lot.traceability.line</field>
        <field name="arch" type="xml">
            <form string="Traceability Line" create="0" edit="0" delete="0">
                <sheet>
                    <group>
                        <field name="date"/>
                        <field name="lot_id"/>
                        <field name="product_id"/>
                        <field name="qty"/>
                        <field name="uom_id"/>
                    </group>
                    <group>
                        <field name="picking_id"/>
                        <field name="picking_type_code"/>
                        <field name="partner_id"/>
                        <field name="origin_ref"/>
                        <field name="production_id"/>
                    </group>
                    <group>
                        <field name="location_from_id"/>
                        <field name="location_to_id"/>
                    </group>
                    <group string="Source Raw Lots">
                        <field name="source_raw_lot_ids" widget="many2many_tags" readonly="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Action for Open Screen -->
    <record id="action_lot_traceability_lines" model="ir.actions.act_window">
        <field name="name">Lot Traceability</field>
        <field name="res_model">lot.traceability.line</field>
        <field name="view_mode">tree,form</field>
        <field name="view_id" ref="lot_traceability_line_tree_view"/>
        <field name="context">{}</field>
    </record>

</odoo>
