<odoo>
    <record id="view_export_lot_traceability_wizard_form" model="ir.ui.view">
        <field name="name">export.lot.traceability.wizard.form</field>
        <field name="model">export.lot.traceability.wizard</field>
        <field name="arch" type="xml">
            <form string="Lot Traceability" create="0" edit="0">
                <header>
                    <button name="action_generate_traceability"
                            type="object"
                            string="Generate"
                            class="btn-primary"/>
                    <button special="cancel" string="Close"/>
                </header>

                <sheet>
                    <group>
                        <field name="invoice_id"/>
                        <field name="shipment_ids" widget="many2many_tags"/>
                        <field name="lot_ids" widget="many2many_tags"/>
                    </group>

                    <notebook>
                        <page string="Traceability Lines">
                            <field name="line_ids">
                                <tree create="0" edit="0" delete="0">
                                    <field name="finished_product"/>
                                    <field name="finished_lot"/>
                                    <field name="production"/>
                                    <field name="production_date"/>
                                    <field name="raw_lots"/>
                                    <field name="vendors"/>
                                    <field name="receipts"/>
                                    <field name="receipt_date"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>
</odoo>
