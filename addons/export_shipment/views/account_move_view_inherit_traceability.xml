<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_move_form_inherit_traceability" model="ir.ui.view">
        <field name="name">account.move.form.inherit.lot.traceability</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">

            <!-- Add button in header next to Print/Pay -->
            <xpath expr="//header" position="inside">
                <button name="action_open_lot_traceability_wizard"
                        type="object"
                        string="Traceability"
                        class="btn-primary"
                        invisible="move_type not in ('out_invoice','out_refund')"/>
            </xpath>

        </field>
    </record>

</odoo>
