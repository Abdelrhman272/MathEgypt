<odoo>
    <record id="view_mrp_production_form_farm_eval" model="ir.ui.view">
        <field name="name">mrp.production.form.farm.evaluation</field>
        <field name="model">mrp.production</field>
        <field name="inherit_id" ref="mrp.mrp_production_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet/group/group" position="after">
                <group>
                    <field name="farm_evaluation_id"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
