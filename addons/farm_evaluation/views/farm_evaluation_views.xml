<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_farm_evaluation_list" model="ir.ui.view">
        <field name="name">farm.evaluation.list</field>
        <field name="model">farm.evaluation</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="date"/>
                <field name="vendor_id"/>
                <field name="raw_product_id"/>
                <field name="total_expected_qty"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <record id="view_farm_evaluation_form" model="ir.ui.view">
        <field name="name">farm.evaluation.form</field>
        <field name="model">farm.evaluation</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_approve" type="object" string="Approve" class="btn-primary"
                            invisible="state != 'draft'"/>
                    <button name="action_create_po" type="object" string="Create PO" class="btn-primary"
                            invisible="state != 'approved'"/>
                    <button name="action_set_draft" type="object" string="Set to Draft"
                            invisible="state in ('draft')"/>
                    <button name="action_cancel" type="object" string="Cancel"
                            invisible="state == 'cancelled'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,approved,po_created,cancelled"/>
                </header>

                <sheet>
                    <h1><field name="name" readonly="1"/></h1>
                    <group>
                        <group>
                            <field name="date"/>
                            <field name="vendor_id"/>
                        </group>
                        <group>
                            <field name="raw_product_id"/>
                            <field name="total_expected_qty"/>
                            <field name="uom_id"/>
                            <field name="purchase_order_id" readonly="1" invisible="not purchase_order_id"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="Grades">
                            <field name="line_ids">
                                <list editable="bottom">
                                    <field name="grade"/>
                                    <field name="expected_percent"/>
                                    <field name="expected_qty" readonly="1"/>
                                    <field name="uom_id" readonly="1"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_farm_evaluation" model="ir.actions.act_window">
        <field name="name">Farm Evaluations</field>
        <field name="res_model">farm.evaluation</field>
        <field name="view_mode">list,form</field>
    </record>

        <record id="farm_evaluation_form_inherit_actuals" model="ir.ui.view">
        <field name="name">farm.evaluation.form.actuals</field>
        <field name="model">farm.evaluation</field>
        <field name="inherit_id" ref="farm_evaluation.view_farm_evaluation_form"/>
        <field name="arch" type="xml">

            <xpath expr="//header" position="inside">
                <button name="action_recompute_actuals"
                        string="Recompute Actuals"
                        type="object"
                        class="btn-primary"/>
            </xpath>

            <xpath expr="//field[@name='line_ids']//list" position="inside">
                <field name="actual_qty"/>
                <field name="variance_qty"/>
                <field name="achievement_percent"/>
            </xpath>

        </field>
    </record>

</odoo>
