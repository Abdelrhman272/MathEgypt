<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="group_agx_user" model="res.groups">
        <field name="name">Agricultural Export User</field>
        <field name="category_id" ref="base.module_category_inventory"/>
    </record>
    <record id="group_agx_manager" model="res.groups">
        <field name="name">Agricultural Export Manager</field>
        <field name="category_id" ref="base.module_category_inventory"/>
        <field name="implied_ids" eval="[(4, ref('agri_export_management.group_agx_user'))]"/>
    </record>
    <record id="group_agx_cost_analyst" model="res.groups">
        <field name="name">Agricultural Export Cost Analyst</field>
        <field name="category_id" ref="base.module_category_inventory"/>
        <field name="implied_ids" eval="[(4, ref('agri_export_management.group_agx_user'))]"/>
    </record>
    <record id="group_agx_admin" model="res.groups">
        <field name="name">Agricultural Export Admin</field>
        <field name="category_id" ref="base.module_category_inventory"/>
        <field name="implied_ids" eval="[(4, ref('agri_export_management.group_agx_manager')), (4, ref('agri_export_management.group_agx_cost_analyst'))]"/>
        <field name="users" eval="[(4, ref('base.user_admin'))]"/>
    </record>
</odoo>
