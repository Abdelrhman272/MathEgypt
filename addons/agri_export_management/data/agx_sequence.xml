<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="seq_agx_evaluation" model="ir.sequence"><field name="name">AGX Evaluation</field><field name="code">agx.evaluation</field><field name="prefix">EVAL/%(year)s/</field><field name="padding">4</field></record>
    <record id="seq_agx_batch" model="ir.sequence"><field name="name">AGX Batch</field><field name="code">agx.batch</field><field name="prefix">BAT/%(year)s/</field><field name="padding">4</field></record>
    <record id="seq_agx_shipment" model="ir.sequence"><field name="name">AGX Shipment</field><field name="code">agx.shipment</field><field name="prefix">SHP/%(year)s/</field><field name="padding">4</field></record>
    <record id="seq_agx_season" model="ir.sequence"><field name="name">AGX Season</field><field name="code">agx.season</field><field name="prefix">SSN/%(year)s/</field><field name="padding">3</field></record>

    <record id="seq_agx_qc_inspection" model="ir.sequence">
        <field name="name">AGX QC Inspection</field>
        <field name="code">agx.qc.inspection</field>
        <field name="prefix">QC/%(year)s/</field>
        <field name="padding">4</field>
        <field name="company_id" eval="False"/>
    </record>

    <record id="seq_agx_claim" model="ir.sequence">
        <field name="name">AGX Customer Claim</field>
        <field name="code">agx.claim</field>
        <field name="prefix">CLM/%(year)s/</field>
        <field name="padding">4</field>
        <field name="company_id" eval="False"/>
    </record>

</odoo>
