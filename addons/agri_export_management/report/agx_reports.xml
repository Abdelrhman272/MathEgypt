<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="action_report_agx_shipment" model="ir.actions.report">
        <field name="name">Shipment Summary</field>
        <field name="model">agx.shipment</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">agri_export_management.report_agx_shipment_summary</field>
        <field name="report_file">agri_export_management.report_agx_shipment_summary</field>
        <field name="binding_model_id" ref="model_agx_shipment"/>
        <field name="binding_type">report</field>
    </record>
    <template id="report_agx_shipment_summary">
        <t t-call="web.html_container"><t t-foreach="docs" t-as="o"><t t-call="web.external_layout"><div class="page"><h2>Shipment Summary</h2><p><strong>Shipment:</strong> <span t-esc="o.name"/></p><p><strong>Customer:</strong> <span t-esc="o.customer_id.display_name"/></p><p><strong>Destination:</strong> <span t-esc="o.destination_id.display_name"/></p><p><strong>Total Logistics Cost:</strong> <span t-esc="o.total_logistics_cost"/></p><p><strong>Revenue:</strong> <span t-esc="o.revenue_amount"/></p><p><strong>Gross Profit:</strong> <span t-esc="o.gross_profit_amount"/></p></div></t></t></t>
    </template>
</odoo>
