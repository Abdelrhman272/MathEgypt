<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!-- Claims list -->
    <record id="view_agx_claim_list" model="ir.ui.view">
        <field name="name">agx.claim.list</field>
        <field name="model">agx.claim</field>
        <field name="arch" type="xml">
            <list decoration-warning="state == 'under_review'"
                  decoration-success="state == 'resolved'"
                  decoration-muted="state in ('rejected','credited')">
                <field name="name"/>
                <field name="claim_date"/>
                <field name="customer_id"/>
                <field name="shipment_id"/>
                <field name="season_id" optional="show"/>
                <field name="claim_type"/>
                <field name="claimed_qty" optional="show"/>
                <field name="claimed_value"/>
                <field name="agreed_credit" optional="show"/>
                <field name="state" widget="badge"
                       decoration-warning="state == 'under_review'"
                       decoration-success="state == 'resolved'"
                       decoration-muted="state == 'rejected'"/>
            </list>
        </field>
    </record>

    <!-- Claims form -->
    <record id="view_agx_claim_form" model="ir.ui.view">
        <field name="name">agx.claim.form</field>
        <field name="model">agx.claim</field>
        <field name="arch" type="xml">
            <form string="Customer Claim">
                <header>
                    <button name="action_review"  string="Start Review"
                            type="object" class="btn-primary"
                            invisible="state != 'draft'"/>
                    <button name="action_resolve" string="Resolve"
                            type="object" class="btn-success"
                            invisible="state not in ('draft','under_review')"/>
                    <button name="action_reject"  string="Reject"
                            type="object"
                            invisible="state not in ('draft','under_review')"/>
                    <button name="action_credit"  string="Credit Note Issued"
                            type="object"
                            invisible="state != 'resolved'"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,under_review,resolved,credited,rejected"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="claim_date"/>
                            <field name="claim_type"/>
                            <field name="shipment_id"/>
                            <field name="customer_id" readonly="1"/>
                            <field name="season_id" readonly="1"/>
                        </group>
                        <group>
                            <field name="claimed_qty"/>
                            <field name="claimed_value"/>
                            <field name="agreed_credit"/>
                            <field name="credit_note_id"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Affected Lots">
                            <field name="lot_ids" widget="many2many_tags"/>
                        </page>
                        <page string="Analysis">
                            <group string="Root Cause">
                                <field name="root_cause" nolabel="1" colspan="2"/>
                            </group>
                            <group string="Resolution">
                                <field name="resolution" nolabel="1" colspan="2"/>
                            </group>
                        </page>
                        <page string="Notes">
                            <field name="note"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Action + Menu -->
    <record id="action_agx_claim" model="ir.actions.act_window">
        <field name="name">Customer Claims</field>
        <field name="res_model">agx.claim</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_agx_claims" name="Customer Claims"
              parent="menu_agx_operations"
              action="action_agx_claim" sequence="50"/>

</odoo>
