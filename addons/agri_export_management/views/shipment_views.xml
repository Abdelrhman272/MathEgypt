<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!-- ================================================================
         SHIPMENT — List (with profitability color coding)
    ================================================================ -->
    <record id="view_agx_shipment_list" model="ir.ui.view">
        <field name="name">agx.shipment.list</field>
        <field name="model">agx.shipment</field>
        <field name="arch" type="xml">
            <list decoration-info="state == 'draft'"
                  decoration-warning="state == 'reserved'"
                  decoration-success="state == 'shipped'"
                  decoration-muted="state == 'cancelled'">
                <field name="name"/>
                <field name="shipment_date"/>
                <field name="customer_id"/>
                <field name="destination_id"/>
                <field name="season_id" optional="show"/>
                <field name="container_count" string="Containers"/>
                <field name="total_qty" string="Qty"/>
                <field name="total_logistics_cost" string="Log. Cost"/>
                <field name="revenue_amount" string="Revenue"/>
                <field name="gross_profit_amount" string="Gross Profit"
                       decoration-danger="gross_profit_amount &lt; 0"
                       decoration-success="gross_profit_amount &gt;= 0"/>
                <field name="gross_margin_pct" string="Margin %"
                       decoration-danger="gross_margin_pct &lt; 0"
                       decoration-warning="gross_margin_pct &lt; 20"
                       decoration-success="gross_margin_pct &gt;= 20"/>
                <field name="state" widget="badge"
                       decoration-info="state == 'draft'"
                       decoration-warning="state == 'reserved'"
                       decoration-success="state == 'shipped'"
                       decoration-muted="state == 'cancelled'"/>
            </list>
        </field>
    </record>

    <!-- ================================================================
         SHIPMENT — Kanban (pipeline view)
    ================================================================ -->
    <record id="view_agx_shipment_kanban" model="ir.ui.view">
        <field name="name">agx.shipment.kanban</field>
        <field name="model">agx.shipment</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state" class="o_kanban_small_column">
                <field name="name"/>
                <field name="shipment_date"/>
                <field name="customer_id"/>
                <field name="destination_id"/>
                <field name="season_id"/>
                <field name="container_count"/>
                <field name="total_qty"/>
                <field name="total_logistics_cost"/>
                <field name="revenue_amount"/>
                <field name="gross_profit_amount"/>
                <field name="gross_margin_pct"/>
                <field name="state"/>
                <field name="etd"/>
                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_global_click">
                            <div class="d-flex justify-content-between">
                                <div class="fw-bold" t-esc="record.name.value"/>
                                <div class="small text-muted"
                                     t-esc="record.shipment_date.value"/>
                            </div>
                            <div class="text-muted small mt-1">
                                👤 <t t-esc="record.customer_id.value"/>
                            </div>
                            <div t-if="record.destination_id.value" class="text-muted small">
                                🚢 <t t-esc="record.destination_id.value"/>
                            </div>
                            <div t-if="record.etd.value" class="text-muted small">
                                📅 ETD: <t t-esc="record.etd.value"/>
                            </div>
                            <div class="row mt-2 text-center">
                                <div class="col-6">
                                    <div class="fw-bold text-primary"
                                         t-esc="record.container_count.value"/>
                                    <div class="small text-muted">Containers</div>
                                </div>
                                <div class="col-6">
                                    <div t-attf-class="fw-bold #{record.gross_margin_pct.raw_value >= 20 ? 'text-success' : record.gross_margin_pct.raw_value >= 0 ? 'text-warning' : 'text-danger'}">
                                        <t t-esc="record.gross_margin_pct.value"/>%
                                    </div>
                                    <div class="small text-muted">Margin</div>
                                </div>
                            </div>
                            <div t-if="record.season_id.value" class="mt-1 small text-muted">
                                🌿 <t t-esc="record.season_id.value"/>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- ================================================================
         SHIPMENT — Search
    ================================================================ -->
    <record id="view_agx_shipment_search" model="ir.ui.view">
        <field name="name">agx.shipment.search</field>
        <field name="model">agx.shipment</field>
        <field name="arch" type="xml">
                        <search string="Search Shipments">
                <field name="name"/>
                <field name="customer_id"/>
                <field name="destination_id"/>
                <field name="season_id"/>
                <field name="bl_number" string="B/L Number"/>
                <filter string="Draft"    name="draft"    domain="[('state','=','draft')]"/>
                <filter string="Reserved" name="reserved" domain="[('state','=','reserved')]"/>
                <filter string="Shipped"  name="shipped"  domain="[('state','=','shipped')]"/>
                <separator/>
                <filter string="Profitable (Margin &gt;= 20%%)" name="profitable"
                        domain="[('gross_margin_pct','&gt;=',20)]"/>
                <filter string="At Risk (Margin &lt; 0%%)" name="at_risk"
                        domain="[('gross_margin_pct','&lt;',0)]"/>
                <separator/>
                <filter string="By Season"      name="gb_season"  context="{'group_by':'season_id'}"/>
                <filter string="By Customer"    name="gb_customer" context="{'group_by':'customer_id'}"/>
                <filter string="By Destination" name="gb_dest"    context="{'group_by':'destination_id'}"/>
                <filter string="By State"       name="gb_state"   context="{'group_by':'state'}"/>
            </search>
        </field>
    </record>

    <!-- ================================================================
         SHIPMENT — Graph
    ================================================================ -->
    <record id="view_agx_shipment_graph" model="ir.ui.view">
        <field name="name">agx.shipment.graph</field>
        <field name="model">agx.shipment</field>
        <field name="arch" type="xml">
            <graph string="Shipment Profitability" type="bar">
                <field name="season_id" type="row"/>
                <field name="destination_id" type="col"/>
                <field name="revenue_amount" type="measure"/>
                <field name="total_logistics_cost" type="measure"/>
                <field name="gross_profit_amount" type="measure"/>
            </graph>
        </field>
    </record>

    <!-- ================================================================
         SHIPMENT — Pivot
    ================================================================ -->
    <record id="view_agx_shipment_pivot" model="ir.ui.view">
        <field name="name">agx.shipment.pivot</field>
        <field name="model">agx.shipment</field>
        <field name="arch" type="xml">
            <pivot string="Shipment Analysis">
                <field name="season_id" type="row"/>
                <field name="destination_id" type="row"/>
                <field name="total_qty" type="measure"/>
                <field name="total_logistics_cost" type="measure"/>
                <field name="revenue_amount" type="measure"/>
                <field name="gross_profit_amount" type="measure"/>
                <field name="gross_margin_pct" type="measure"/>
                <field name="container_count" type="measure"/>
            </pivot>
        </field>
    </record>

    <!-- ================================================================
         SHIPMENT — Form
    ================================================================ -->
    <record id="view_agx_shipment_form" model="ir.ui.view">
        <field name="name">agx.shipment.form</field>
        <field name="model">agx.shipment</field>
        <field name="arch" type="xml">
            <form string="Export Shipment">
                <header>
                    <button name="action_reserve" string="Reserve Lots"
                            type="object" class="btn-primary"
                            invisible="state != 'draft'"/>
                    <button name="action_create_sale_order"
                            string="Create Sale Order"
                            type="object"
                            invisible="state not in ('draft','reserved') or sale_order_id"/>
                    <button name="action_view_sale_order" string="View Sale Order"
                            type="object" invisible="not sale_order_id"/>
                    <button name="action_view_delivery" string="View Delivery"
                            type="object" invisible="not delivery_picking_id"/>
                    <button name="action_ship" string="Mark Shipped"
                            type="object" class="btn-primary"
                            invisible="state != 'reserved'"/>
                    <button name="action_cancel" string="Cancel"
                            type="object"
                            invisible="state in ('cancelled','shipped')"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,reserved,shipped,cancelled"/>
                </header>
                <sheet>
                    <!-- Smart buttons -->
                    <div class="oe_button_box" name="button_box">
                        <button class="oe_stat_button" name="action_view_sale_order"
                                type="object" icon="fa-shopping-cart"
                                invisible="not sale_order_id">
                            <field name="sale_order_id" widget="statinfo" string="Sales Order"/>
                        </button>
                        <button class="oe_stat_button" name="action_view_delivery"
                                type="object" icon="fa-truck"
                                invisible="not delivery_picking_id">
                            <field name="delivery_picking_id" widget="statinfo" string="Delivery"/>
                        </button>
                        <button class="oe_stat_button" type="object"
                                name="action_view_claims" icon="fa-exclamation-triangle"
                                invisible="claim_count == 0">
                            <field name="claim_count" widget="statinfo" string="Claims"/>
                        </button>
                        <button class="oe_stat_button" type="object"
                                name="action_view_qc_inspections" icon="fa-check-circle"
                                invisible="qc_count == 0">
                            <field name="qc_count" widget="statinfo" string="QC"/>
                        </button>
                    </div>

                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>

                    <!-- Main fields -->
                    <group>
                        <group string="Shipment Info">
                            <field name="shipment_date"/>
                            <field name="customer_id"/>
                            <field name="destination_id"/>
                            <field name="season_id"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                        <group string="Container Info">
                            <field name="container_count"/>
                            <field name="container_no" readonly="1"/>
                            <field name="seal_no" readonly="1"/>
                        </group>
                    </group>
                    <group>
                        <group string="Freight Details">
                            <field name="vessel_name"/>
                            <field name="voyage_no"/>
                            <field name="etd"/>
                            <field name="eta"/>
                            <field name="bl_number"/>
                        </group>
                        <group string="Profitability">
                            <field name="total_qty" readonly="1"/>
                            <field name="total_reserved_qty" readonly="1"/>
                            <field name="revenue_amount" readonly="1"/>
                            <field name="total_logistics_cost" readonly="1"/>
                            <field name="gross_profit_amount" readonly="1"
                                   decoration-danger="gross_profit_amount &lt; 0"/>
                            <field name="gross_margin_pct" readonly="1"
                                  
                                   decoration-danger="gross_margin_pct &lt; 0"
                                   decoration-warning="gross_margin_pct &lt; 20"
                                   decoration-success="gross_margin_pct &gt;= 20"/>
                        </group>
                    </group>

                    <notebook>
                        <!-- Containers tab -->
                        <page string="Containers" name="containers">
                            <field name="container_ids">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="name"/>
                                    <field name="container_no"/>
                                    <field name="seal_no"/>
                                    <field name="note" optional="hide"/>
                                </list>
                            </field>
                        </page>

                        <!-- Products tab -->
                        <page string="Products" name="products">
                            <field name="line_ids">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="container_id"
                                           domain="[('shipment_id','=',parent.id)]"/>
                                    <field name="product_id"/>
                                    <field name="grade_id"/>
                                    <field name="size_id"/>
                                    <field name="product_qty"/>
                                    <field name="uom_id"/>
                                    <field name="carton_qty"/>
                                    <field name="net_weight"/>
                                    <field name="gross_weight"/>
                                </list>
                            </field>
                        </page>

                        <!-- Reserved Lots tab -->
                        <page string="Reserved Lots" name="lots">
                            <field name="lot_line_ids">
                                <list editable="bottom">
                                    <field name="container_id"/>
                                    <field name="shipment_line_id"/>
                                    <field name="product_id"/>
                                    <field name="lot_id"/>
                                    <field name="batch_output_id" optional="show"/>
                                    <field name="reserved_qty"/>
                                    <field name="carton_count" string="Cartons"/>
                                    <field name="pallet_ref" string="Pallet Ref" optional="show"/>
                                    <field name="pallet_count" string="Pallets" optional="show"/>
                                    <field name="available_qty" optional="hide"/>
                                    <field name="note" optional="hide"/>
                                </list>
                            </field>
                        </page>

                        <!-- Logistics Costs tab -->
                        <page string="Logistics Costs" name="costs">
                            <group>
                                <group>
                                    <field name="total_logistics_cost" readonly="1"/>
                                    <field name="cost_per_container" readonly="1"/>
                                </group>
                                <group>
                                    <field name="gross_profit_amount" readonly="1"/>
                                    <field name="gross_margin_pct" readonly="1"
                                          />
                                </group>
                            </group>
                            <field name="cost_line_ids">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="name"/>
                                    <field name="cost_type_id"/>
                                    <field name="allocation_basis"/>
                                    <field name="cost_source"/>
                                    <field name="manual_amount"/>
                                    <field name="source_amount" readonly="1"/>
                                    <field name="effective_amount" readonly="1"/>
                                    <field name="vendor_bill_id" optional="hide"/>
                                    <field name="vendor_bill_line_id" optional="hide"/>
                                    <field name="landed_cost_id" optional="hide"/>
                                    <field name="note" optional="hide"/>
                                </list>
                            </field>
                            <separator string="Allocated Cost per Product Line"/>
                            <field name="line_ids" readonly="1">
                                <list>
                                    <field name="container_id"/>
                                    <field name="product_id"/>
                                    <field name="grade_id"/>
                                    <field name="size_id"/>
                                    <field name="product_qty"/>
                                    <field name="carton_qty"/>
                                    <field name="allocated_logistics_cost" readonly="1"/>
                                    <field name="cost_per_carton" readonly="1"/>
                                    <field name="cost_per_qty" readonly="1"/>
                                </list>
                            </field>
                        </page>

                        <!-- Notes -->
                        <page string="Notes" name="notes">
                            <field name="note"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Actions + Menus -->
    <record id="action_agx_shipment" model="ir.actions.act_window">
        <field name="name">Export Shipments</field>
        <field name="res_model">agx.shipment</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="search_view_id" ref="view_agx_shipment_search"/>
    </record>
    <menuitem id="menu_agx_shipment" name="Export Shipments"
              parent="menu_agx_operations"
              action="action_agx_shipment" sequence="30"/>

    <record id="action_agx_shipment_profitability" model="ir.actions.act_window">
        <field name="name">Shipment Profitability Analysis</field>
        <field name="res_model">agx.shipment</field>
        <field name="view_mode">graph,pivot</field>
        <field name="search_view_id" ref="view_agx_shipment_search"/>
    </record>
    <menuitem id="menu_agx_shipment_profitability" name="Shipment Profitability"
              parent="menu_agx_analytics"
              action="action_agx_shipment_profitability" sequence="10"/>

</odoo>
