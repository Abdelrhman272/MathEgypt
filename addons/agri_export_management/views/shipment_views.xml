<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_agx_shipment_list" model="ir.ui.view"><field name="name">agx.shipment.list</field><field name="model">agx.shipment</field><field name="arch" type="xml"><list><field name="name"/><field name="shipment_date"/><field name="customer_id"/><field name="destination_id"/><field name="container_no"/><field name="total_qty"/><field name="total_logistics_cost"/><field name="revenue_amount"/><field name="gross_profit_amount"/><field name="gross_margin_pct"/><field name="state"/></list></field></record>
    <record id="view_agx_shipment_form" model="ir.ui.view">
        <field name="name">agx.shipment.form</field>
        <field name="model">agx.shipment</field>
        <field name="arch" type="xml">
            <form string="Shipment">
                <header>
                    <button name="action_reserve" string="Reserve Lots" type="object" class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_create_sale_order" string="Create Sale Order" type="object" invisible="state not in ('draft','reserved') or sale_order_id"/>
                    <button name="action_view_sale_order" string="View Sale Order" type="object" invisible="not sale_order_id"/>
                    <button name="action_ship" string="Mark Shipped" type="object" invisible="state != 'reserved'"/>
                    <button name="action_cancel" string="Cancel" type="object" invisible="state == 'cancelled'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,reserved,shipped,cancelled"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button class="oe_stat_button" name="action_view_sale_order" type="object" icon="fa-shopping-cart" invisible="not sale_order_id">
                            <field name="sale_order_id" widget="statinfo" string="Sales Order"/>
                        </button>
                    </div>
                    <div class="oe_title"><h1><field name="name" readonly="1"/></h1></div>
                    <group>
                        <group>
                            <field name="shipment_date"/>
                            <field name="customer_id"/>
                            <field name="destination_id"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                        <group>
                            <field name="container_no"/>
                            <field name="container_count"/>
                            <field name="seal_no"/>
                        </group>
                    </group>
                    <group>
                        <group>
                            <field name="total_qty" readonly="1"/>
                            <field name="total_reserved_qty" readonly="1"/>
                            <field name="total_logistics_cost" readonly="1"/>
                        </group>
                        <group>
                            <field name="revenue_amount" readonly="1"/>
                            <field name="gross_profit_amount" readonly="1"/>
                            <field name="gross_margin_pct" readonly="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Products">
                            <field name="line_ids">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="product_id"/>
                                    <field name="grade_id"/>
                                    <field name="size_id"/>
                                    <field name="product_qty"/>
                                    <field name="uom_id"/>
                                    <field name="carton_qty"/>
                                    <field name="net_weight"/>
                                    <field name="gross_weight"/>
                                    <field name="allocated_logistics_cost" readonly="1"/>
                                    <field name="cost_per_carton" readonly="1"/>
                                    <field name="cost_per_qty" readonly="1"/>
                                </list>
                            </field>
                        </page>
                        <page string="Reserved Lots">
                            <field name="lot_line_ids" readonly="1">
                                <list>
                                    <field name="shipment_line_id"/>
                                    <field name="product_id"/>
                                    <field name="lot_id"/>
                                    <field name="batch_output_id"/>
                                    <field name="available_qty"/>
                                    <field name="reserved_qty"/>
                                </list>
                            </field>
                        </page>
                        <page string="Logistics Costs">
                            <group>
                                <group><field name="total_logistics_cost" readonly="1"/><field name="cost_per_container" readonly="1"/></group>
                                <group><field name="revenue_amount" readonly="1"/><field name="gross_profit_amount" readonly="1"/><field name="gross_margin_pct" readonly="1"/></group>
                            </group>
                            <field name="cost_line_ids">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="name"/>
                                    <field name="cost_type_id"/>
                                    <field name="allocation_basis"/>
                                    <field name="cost_source"/>
                                    <field name="manual_amount"/>
                                    <field name="source_amount" readonly="1"/>
                                    <field name="effective_amount" readonly="1"/>
                                    <field name="vendor_bill_id" optional="hide"/>
                                    <field name="vendor_bill_line_id" optional="hide"/>
                                    <field name="landed_cost_id" optional="hide"/>
                                    <field name="note" optional="hide"/>
                                </list>
                            </field>
                        </page>
                        <page string="Notes"><field name="note"/></page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <record id="action_agx_shipment" model="ir.actions.act_window"><field name="name">Shipments</field><field name="res_model">agx.shipment</field><field name="view_mode">list,form</field></record>
    <menuitem id="menu_agx_shipment" name="Shipments" parent="menu_agx_operations" action="action_agx_shipment" sequence="30"/>

    <record id="action_agx_shipment_profitability" model="ir.actions.act_window"><field name="name">Shipment Profitability Analysis</field><field name="res_model">agx.shipment</field><field name="view_mode">graph,pivot</field></record>
    <menuitem id="menu_agx_shipment_profitability" name="Shipment Profitability Analysis" parent="menu_agx_analytics" action="action_agx_shipment_profitability" sequence="10"/>
</odoo>
