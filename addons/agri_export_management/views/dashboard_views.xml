<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_agx_dashboard_form" model="ir.ui.view">
        <field name="name">agx.dashboard.form</field>
        <field name="model">agx.dashboard</field>
        <field name="arch" type="xml">
            <form string="Agricultural Export Dashboard" create="0" edit="1" delete="0">
                <header>
                    <button name="action_refresh_dashboard" string="Refresh" type="object" class="btn-primary"/>
                    <button name="action_open_profitability" string="Open Profitability Analysis" type="object"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>Agricultural Export Dashboard</h1>
                    </div>
                    <div class="oe_button_box" name="button_box">
                        <button class="oe_stat_button" type="object" name="action_open_evaluations" icon="fa-leaf">
                            <field name="open_evaluations_count" widget="statinfo" string="Open Evaluations"/>
                        </button>
                        <button class="oe_stat_button" type="object" name="action_open_incoming_receipts" icon="fa-truck">
                            <field name="raw_material_received_count" widget="statinfo" string="Incoming Receipts"/>
                        </button>
                        <button class="oe_stat_button" type="object" name="action_open_batches" icon="fa-industry">
                            <field name="active_batches_count" widget="statinfo" string="Active Batches"/>
                        </button>
                        <button class="oe_stat_button" type="object" name="action_open_shipments" icon="fa-ship">
                            <field name="pending_shipments_count" widget="statinfo" string="Pending Shipments"/>
                        </button>
                    </div>
                    <group>
                        <group>
                            <field name="company_id" options="{'no_create': True}"/>
                        </group>
                        <group>
                            <field name="date_from"/>
                            <field name="date_to"/>
                        </group>
                    </group>
                    <separator string="Operations Overview"/>
                    <group col="4">
                        <group string="Evaluations">
                            <field name="open_evaluations_count" readonly="1"/>
                            <field name="approved_evaluations_count" readonly="1"/>
                            <field name="pending_purchases_count" readonly="1"/>
                        </group>
                        <group string="Operations">
                            <field name="raw_material_received_count" readonly="1"/>
                            <field name="active_batches_count" readonly="1"/>
                            <field name="pending_shipments_count" readonly="1"/>
                            <field name="shipped_shipments_count" readonly="1"/>
                        </group>
                        <group string="Reservations">
                            <field name="reserved_lots_qty" readonly="1"/>
                        </group>
                        <group string="Business Highlights">
                            <field name="top_destination_name" readonly="1"/>
                            <field name="top_customer_name" readonly="1"/>
                            <field name="highest_cost_shipment_name" readonly="1"/>
                            <field name="highest_margin_shipment_name" readonly="1"/>
                        </group>
                    </group>
                    <separator string="Profitability Snapshot"/>
                    <group col="4">
                        <group>
                            <field name="logistics_cost_period" readonly="1"/>
                        </group>
                        <group>
                            <field name="revenue_period" readonly="1"/>
                        </group>
                        <group>
                            <field name="gross_profit_period" readonly="1"/>
                        </group>
                        <group>
                            <field name="margin_pct_period" readonly="1"/>
                        </group>
                    </group>
                    <div class="text-muted o_form_label">For richer visual dashboards in Odoo 19, use Odoo Spreadsheet / Dashboards on top of this module's live data.</div>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_agx_dashboard_server" model="ir.actions.server">
        <field name="name">Agricultural Export Dashboard</field>
        <field name="model_id" ref="model_agx_dashboard"/>
        <field name="state">code</field>
        <field name="code">action = env['agx.dashboard'].action_open_dashboard()</field>
    </record>

    <menuitem id="menu_agx_dashboard" name="Dashboard" parent="menu_agx_root" action="action_agx_dashboard_server" sequence="1"/>
</odoo>
