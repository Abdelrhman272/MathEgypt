<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!-- ================================================================
         AGX Dashboard — Client Action (OWL HTML page)
         Registered as 'agx_dashboard_action' in the JS registry.
         The old form view is kept as a fallback for mobile/simple access.
    ================================================================ -->

    <!-- Client action that loads the OWL component -->
    <record id="action_agx_dashboard_client" model="ir.actions.client">
        <field name="name">Agricultural Export Dashboard</field>
        <field name="tag">agx_dashboard_action</field>
    </record>

    <!-- Fallback form view (kept for reference) -->
    <record id="view_agx_dashboard_form" model="ir.ui.view">
        <field name="name">agx.dashboard.form</field>
        <field name="model">agx.dashboard</field>
        <field name="arch" type="xml">
            <form string="Agricultural Export Dashboard" create="0" edit="1" delete="0">
                <header>
                    <button name="action_open_profitability" string="Profitability Analysis"
                            type="object" class="btn-secondary"/>
                </header>
                <sheet>
                    <div class="oe_title"><h1>Agricultural Export Dashboard</h1></div>
                    <div class="oe_button_box" name="button_box">
                        <button class="oe_stat_button" type="object"
                                name="action_open_evaluations" icon="fa-leaf">
                            <field name="open_evaluations_count" widget="statinfo"
                                   string="Open Evaluations"/>
                        </button>
                        <button class="oe_stat_button" type="object"
                                name="action_open_incoming_receipts" icon="fa-truck">
                            <field name="pending_incoming_receipts_count" widget="statinfo"
                                   string="Pending Receipts"/>
                        </button>
                        <button class="oe_stat_button" type="object"
                                name="action_open_batches" icon="fa-industry">
                            <field name="active_batches_count" widget="statinfo"
                                   string="Active Batches"/>
                        </button>
                        <button class="oe_stat_button" type="object"
                                name="action_open_shipments" icon="fa-ship">
                            <field name="pending_shipments_count" widget="statinfo"
                                   string="Pending Shipments"/>
                        </button>
                    </div>
                    <group>
                        <group>
                            <field name="company_id" options="{'no_create': True}"/>
                            <field name="season_id"/>
                        </group>
                        <group>
                            <field name="date_from"/>
                            <field name="date_to"/>
                        </group>
                    </group>
                    <separator string="Profitability Snapshot"/>
                    <group col="4">
                        <group><field name="logistics_cost_period" readonly="1"/></group>
                        <group><field name="revenue_period" readonly="1"/></group>
                        <group><field name="gross_profit_period" readonly="1"/></group>
                        <group><field name="margin_pct_period" readonly="1"/></group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Menu points to client action -->
    <menuitem id="menu_agx_dashboard" name="Dashboard"
              parent="menu_agx_root"
              action="action_agx_dashboard_client"
              sequence="1"/>

</odoo>
