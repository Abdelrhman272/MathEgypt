<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!-- ================================================================
         GRADE — list + form (bridge to product.attribute.value)
    ================================================================ -->
    <record id="view_agx_grade_list" model="ir.ui.view">
        <field name="name">agx.grade.list</field>
        <field name="model">agx.grade</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="code"/>
                <field name="attribute_value_id" optional="show"/>
            </list>
        </field>
    </record>

    <record id="view_agx_grade_form" model="ir.ui.view">
        <field name="name">agx.grade.form</field>
        <field name="model">agx.grade</field>
        <field name="arch" type="xml">
            <form string="Grade">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="code"/>
                            <field name="sequence"/>
                        </group>
                        <group>
                            <field name="attribute_value_id"
                                   help="Linked product attribute value (set by Initialize wizard)"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- ================================================================
         SIZE
    ================================================================ -->
    <record id="view_agx_size_list" model="ir.ui.view">
        <field name="name">agx.size.list</field>
        <field name="model">agx.size</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence" widget="handle"/>
                <field name="number"/>
                <field name="name" optional="show"/>
                <field name="attribute_value_id" optional="show"/>
            </list>
        </field>
    </record>

    <record id="view_agx_size_form" model="ir.ui.view">
        <field name="name">agx.size.form</field>
        <field name="model">agx.size</field>
        <field name="arch" type="xml">
            <form string="Size">
                <sheet>
                    <group>
                        <group>
                            <field name="number"/>
                            <field name="sequence"/>
                        </group>
                        <group>
                            <field name="attribute_value_id"
                                   help="Linked product attribute value (set by Initialize wizard)"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- ================================================================
         SEASON
    ================================================================ -->
    <record id="view_agx_season_list" model="ir.ui.view">
        <field name="name">agx.season.list</field>
        <field name="model">agx.season</field>
        <field name="arch" type="xml">
            <list decoration-success="state == 'active'"
                  decoration-muted="state == 'closed'">
                <field name="name"/>
                <field name="code"/>
                <field name="date_start"/>
                <field name="date_end"/>
                <field name="analytic_account_id" optional="show"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'active'"
                       decoration-muted="state == 'closed'"/>
            </list>
        </field>
    </record>

    <record id="view_agx_season_form" model="ir.ui.view">
        <field name="name">agx.season.form</field>
        <field name="model">agx.season</field>
        <field name="arch" type="xml">
            <form string="Production Season">
                <header>
                    <button name="action_activate" string="Activate"
                            type="object" class="btn-primary"
                            invisible="state != 'draft'"/>
                    <button name="action_close" string="Close Season"
                            type="object"
                            invisible="state != 'active'"/>
                    <button name="action_reset_draft" string="Reset"
                            type="object"
                            invisible="state == 'draft'"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,active,closed"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button class="oe_stat_button" type="object"
                                name="action_view_evaluations" icon="fa-leaf"
                                invisible="evaluation_count == 0">
                            <field name="evaluation_count" widget="statinfo"
                                   string="Evaluations"/>
                        </button>
                        <button class="oe_stat_button" type="object"
                                name="action_view_batches" icon="fa-industry"
                                invisible="batch_count == 0">
                            <field name="batch_count" widget="statinfo"
                                   string="Batches"/>
                        </button>
                        <button class="oe_stat_button" type="object"
                                name="action_view_shipments" icon="fa-ship"
                                invisible="shipment_count == 0">
                            <field name="shipment_count" widget="statinfo"
                                   string="Shipments"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="code"/>
                            <field name="date_start"/>
                            <field name="date_end"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                        <group>
                            <field name="analytic_account_id" readonly="1"/>
                        </group>
                    </group>
                    <field name="note" placeholder="Notes..."/>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- ================================================================
         SHIPMENT COST TYPE
    ================================================================ -->
    <record id="view_agx_shipment_cost_type_list" model="ir.ui.view">
        <field name="name">agx.shipment.cost.type.list</field>
        <field name="model">agx.shipment.cost.type</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="code"/>
                <field name="default_allocation_basis"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_agx_shipment_cost_type_form" model="ir.ui.view">
        <field name="name">agx.shipment.cost.type.form</field>
        <field name="model">agx.shipment.cost.type</field>
        <field name="arch" type="xml">
            <form string="Shipment Cost Type">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="code"/>
                            <field name="sequence"/>
                        </group>
                        <group>
                            <field name="default_allocation_basis"/>
                            <field name="active"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- ================================================================
         FARM PARTNERS — extends res.partner list/form via filter
         (no separate model — farms are res.partner with is_agx_farm=True)
    ================================================================ -->
    <record id="action_agx_farm_partners" model="ir.actions.act_window">
        <field name="name">Farms</field>
        <field name="res_model">res.partner</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('is_agx_farm', '=', True)]</field>
        <field name="context">{'default_is_agx_farm': True, 'default_supplier_rank': 1}</field>
    </record>

    <!-- ================================================================
         CROP CATEGORIES — extends product.category via filter
    ================================================================ -->
    <record id="action_agx_crop_categories" model="ir.actions.act_window">
        <field name="name">Crops / Varieties</field>
        <field name="res_model">product.category</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('is_agx_crop', '=', True)]</field>
        <field name="context">{'default_is_agx_crop': True}</field>
    </record>

    <!-- ================================================================
         ACTIONS
    ================================================================ -->
    <record id="action_agx_grade" model="ir.actions.act_window">
        <field name="name">Grades</field>
        <field name="res_model">agx.grade</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="action_agx_size" model="ir.actions.act_window">
        <field name="name">Sizes</field>
        <field name="res_model">agx.size</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="action_agx_season" model="ir.actions.act_window">
        <field name="name">Production Seasons</field>
        <field name="res_model">agx.season</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="action_agx_shipment_cost_type" model="ir.actions.act_window">
        <field name="name">Shipment Cost Types</field>
        <field name="res_model">agx.shipment.cost.type</field>
        <field name="view_mode">list,form</field>
    </record>


    <!-- ================================================================
         MENUS
    ================================================================ -->
    <menuitem id="menu_agx_grades" name="Grades"
              parent="menu_agx_master_data"
              action="action_agx_grade" sequence="10"/>

    <menuitem id="menu_agx_sizes" name="Sizes"
              parent="menu_agx_master_data"
              action="action_agx_size" sequence="20"/>

    <menuitem id="menu_agx_seasons" name="Production Seasons"
              parent="menu_agx_master_data"
              action="action_agx_season" sequence="30"/>

    <menuitem id="menu_agx_shipment_cost_types" name="Shipment Cost Types"
              parent="menu_agx_master_data"
              action="action_agx_shipment_cost_type" sequence="40"/>

    <menuitem id="menu_agx_farms" name="Farms"
              parent="menu_agx_master_data"
              action="action_agx_farm_partners" sequence="50"/>

    <menuitem id="menu_agx_crops" name="Crops / Varieties"
              parent="menu_agx_master_data"
              action="action_agx_crop_categories" sequence="60"/>

</odoo>
