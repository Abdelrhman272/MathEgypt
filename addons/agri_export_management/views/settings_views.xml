<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_agx_res_config_settings" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.agx</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base_setup.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app string="Agricultural Export" name="agri_export_management" logo="/agri_export_management/static/description/icon.png">
                    <block title="Shipment Settings">
                        <setting string="Container Service Product" help="Default service product used when creating the shipment sales order."><field name="agx_container_service_product_id"/></setting>
                        <setting string="SO Line Prefix" help="Prefix used in generated sales order lines."><field name="agx_so_line_prefix"/></setting>
                    </block>
                    <block title="Costing Settings">
                        <setting string="Default Logistics Allocation Basis"><field name="agx_default_logistics_basis"/></setting>
                        <setting string="Allow Vendor Bill Cost Source"><field name="agx_allow_vendor_bill_cost_source"/></setting>
                        <setting string="Allow Landed Cost Source"><field name="agx_allow_landed_cost_source"/></setting>
                        <setting string="Margin Precision"><field name="agx_margin_precision"/></setting>
                    </block>
                    <block title="Lot Settings">
                        <setting string="Auto-generate Lot Numbers"><field name="agx_auto_generate_lot_numbers"/></setting>
                    </block>
                    <block title="Stock Integration Settings">
                        <setting string="Production Location"><field name="agx_production_location_id"/></setting>
                        <setting string="Finished Goods Location"><field name="agx_finished_goods_location_id"/></setting>
                        <setting string="Raw Material Location"><field name="agx_raw_material_location_id"/></setting>
                        <setting string="Internal Transfer Type"><field name="agx_internal_picking_type_id" domain="[('code', '=', 'internal')]"/></setting>
                        <setting string="Outgoing Delivery Type"><field name="agx_outgoing_picking_type_id" domain="[('code', '=', 'outgoing')]"/></setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>
    <record id="action_agx_settings" model="ir.actions.act_window"><field name="name">Settings</field><field name="res_model">res.config.settings</field><field name="view_mode">form</field><field name="target">current</field><field name="context">{'module': 'agri_export_management'}</field></record>
    <menuitem id="menu_agx_settings" name="Settings" parent="menu_agx_configuration" action="action_agx_settings" sequence="10"/>
</odoo>
