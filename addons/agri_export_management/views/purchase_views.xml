<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_purchase_order_form_agx_inherit" model="ir.ui.view">
        <field name="name">purchase.order.form.agx.inherit</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='partner_id']" position="after">
                <field name="agx_evaluation_id" options="{'no_create': True}"/>
            </xpath>
        </field>
    </record>

    <record id="view_picking_form_agx_inherit" model="ir.ui.view">
        <field name="name">stock.picking.form.agx.inherit</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='origin']" position="after">
                <field name="agx_evaluation_id" readonly="1"/>
                <field name="agx_batch_id" readonly="1"/>
                <field name="agx_shipment_id" readonly="1"/>
                <field name="agx_flow_type" readonly="1"/>
            </xpath>
        </field>
    </record>
</odoo>
