<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_purchase_order_form_agx" model="ir.ui.view">
        <field name="name">purchase.order.form.agx</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='partner_id']" position="after">
                <field name="agx_evaluation_id" invisible="1"/>
            </xpath>
        </field>
    </record>

    <record id="view_stock_picking_form_agx" model="ir.ui.view">
        <field name="name">stock.picking.form.agx</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='origin']" position="after">
                <field name="agx_evaluation_id" readonly="1"/>
                <field name="agx_flow_type" readonly="1"/>
            </xpath>
        </field>
    </record>

    </odoo>
