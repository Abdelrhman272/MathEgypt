<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_agx_evaluation_list" model="ir.ui.view"><field name="name">agx.evaluation.list</field><field name="model">agx.evaluation</field><field name="arch" type="xml"><list><field name="name"/><field name="evaluation_date"/><field name="farm_id"/><field name="partner_id"/><field name="expected_total_qty"/><field name="estimated_purchase_value"/><field name="state"/></list></field></record>
    <record id="view_agx_evaluation_form" model="ir.ui.view"><field name="name">agx.evaluation.form</field><field name="model">agx.evaluation</field><field name="arch" type="xml"><form string="Farm Evaluation"><header><button name="action_approve" string="Approve" type="object" class="btn-primary" invisible="state != 'draft'"/><button name="action_create_purchase_order" string="Create Purchase Order" type="object" invisible="state not in ('approved', 'po_created')"/><button name="action_view_purchase_order" string="View Purchase Order" type="object" invisible="not po_id"/><button name="action_reset_draft" string="Reset to Draft" type="object" invisible="state == 'draft'"/><button name="action_cancel" string="Cancel" type="object" invisible="state == 'cancelled'"/><field name="state" widget="statusbar" statusbar_visible="draft,approved,po_created,closed,cancelled"/></header><sheet><div class="oe_title"><h1><field name="name" readonly="1"/></h1></div><group><group><field name="evaluation_date"/><field name="farm_id"/><field name="partner_id"/><field name="crop_id"/></group><group><field name="company_id" groups="base.group_multi_company"/><field name="expected_total_qty" readonly="1"/><field name="estimated_purchase_value" readonly="1"/><field name="po_id" readonly="1"/></group></group><notebook><page string="Grades &amp; Sizes"><field name="line_ids"><list editable="bottom"><field name="sequence" widget="handle"/><field name="product_id"/><field name="grade_id"/><field name="size_id"/><field name="expected_ratio"/><field name="expected_qty"/><field name="uom_id"/><field name="estimated_unit_price"/><field name="note"/></list></field></page><page string="Notes"><field name="note"/></page></notebook></sheet><chatter/></form></field></record>
    <record id="action_agx_evaluation" model="ir.actions.act_window"><field name="name">Farm Evaluations</field><field name="res_model">agx.evaluation</field><field name="view_mode">list,form</field></record>
    <menuitem id="menu_agx_evaluation" name="Farm Evaluations" parent="menu_agx_procurement" action="action_agx_evaluation" sequence="10"/>

    <record id="action_agx_incoming_receipts" model="ir.actions.act_window"><field name="name">Incoming Receipts</field><field name="res_model">stock.picking</field><field name="view_mode">list,form</field><field name="domain">[("picking_type_id.code", "=", "incoming")]</field></record>
    <menuitem id="menu_agx_incoming_receipts" name="Incoming Receipts" parent="menu_agx_operations" action="action_agx_incoming_receipts" sequence="10"/>
</odoo>
