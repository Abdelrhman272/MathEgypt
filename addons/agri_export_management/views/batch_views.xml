<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!-- ================================================================
         PRODUCTION BATCH — List
    ================================================================ -->
    <record id="view_agx_batch_list" model="ir.ui.view">
        <field name="name">agx.batch.list</field>
        <field name="model">agx.batch</field>
        <field name="arch" type="xml">
            <list decoration-info="state == 'draft'"
                  decoration-warning="state == 'in_progress'"
                  decoration-success="state == 'done'"
                  decoration-muted="state == 'cancelled'">
                <field name="name"/>
                <field name="batch_date"/>
                <field name="evaluation_id"/>
                <field name="season_id" optional="show"/>
                <field name="input_qty" string="Input Qty"/>
                <field name="output_qty" string="Output Qty"/>
                <field name="variance_qty" string="Variance"
                       decoration-danger="variance_qty &lt; 0"
                       decoration-success="variance_qty &gt;= 0"/>
                <field name="effective_allocable_cost" string="Total Cost"/>
                <field name="costing_status" widget="badge"
                       decoration-success="costing_status == 'actual'"
                       decoration-warning="costing_status == 'manual'"/>
                <field name="stock_move_state" widget="badge"
                       decoration-success="stock_move_state == 'done'"
                       decoration-warning="stock_move_state == 'partial'"
                       decoration-muted="stock_move_state == 'none'"/>
                <field name="state" widget="badge"
                       decoration-info="state == 'draft'"
                       decoration-warning="state == 'in_progress'"
                       decoration-success="state == 'done'"
                       decoration-muted="state == 'cancelled'"/>
            </list>
        </field>
    </record>

    <!-- ================================================================
         PRODUCTION BATCH — Kanban
    ================================================================ -->
    <record id="view_agx_batch_kanban" model="ir.ui.view">
        <field name="name">agx.batch.kanban</field>
        <field name="model">agx.batch</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state" class="o_kanban_small_column">
                <field name="name"/>
                <field name="batch_date"/>
                <field name="evaluation_id"/>
                <field name="season_id"/>
                <field name="input_qty"/>
                <field name="output_qty"/>
                <field name="variance_qty"/>
                <field name="effective_allocable_cost"/>
                <field name="costing_status"/>
                <field name="state"/>
                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_global_click">
                            <div class="fw-bold" t-esc="record.name.value"/>
                            <div class="text-muted small">
                                <t t-esc="record.batch_date.value"/>
                            </div>
                            <div t-if="record.evaluation_id.value" class="text-muted small">
                                📋 <t t-esc="record.evaluation_id.value"/>
                            </div>
                            <div t-if="record.season_id.value" class="text-muted small">
                                🌿 <t t-esc="record.season_id.value"/>
                            </div>
                            <div class="row mt-2 text-center">
                                <div class="col-4">
                                    <div class="fw-bold text-primary"
                                         t-esc="record.input_qty.value"/>
                                    <div class="small text-muted">In</div>
                                </div>
                                <div class="col-4">
                                    <div class="fw-bold text-success"
                                         t-esc="record.output_qty.value"/>
                                    <div class="small text-muted">Out</div>
                                </div>
                                <div class="col-4">
                                    <div t-attf-class="fw-bold #{record.variance_qty.raw_value >= 0 ? 'text-success' : 'text-danger'}"
                                         t-esc="record.variance_qty.value"/>
                                    <div class="small text-muted">Var</div>
                                </div>
                            </div>
                            <div class="mt-2 small">
                                <span class="badge"
                                      t-attf-class="#{record.costing_status.raw_value == 'actual' ? 'bg-success' : 'bg-warning'}">
                                    <t t-esc="record.costing_status.value"/>
                                </span>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- ================================================================
         PRODUCTION BATCH — Search
    ================================================================ -->
    <record id="view_agx_batch_search" model="ir.ui.view">
        <field name="name">agx.batch.search</field>
        <field name="model">agx.batch</field>
        <field name="arch" type="xml">
            <search string="Search Batches">
                <field name="name"/>
                <field name="evaluation_id"/>
                <field name="season_id"/>
                <separator/>
                <filter string="Draft"       name="draft"       domain="[('state','=','draft')]"/>
                <filter string="In Progress" name="in_progress" domain="[('state','=','in_progress')]"/>
                <filter string="Done"        name="done"        domain="[('state','=','done')]"/>
                <separator/>
                <filter string="Manual Costing" name="manual" domain="[('costing_status','=','manual')]"/>
                <filter string="Actual Costing" name="actual" domain="[('costing_status','=','actual')]"/>
                <group expand="0" string="Group By">
                    <filter string="Season"     name="gb_season"  context="{'group_by':'season_id'}"/>
                    <filter string="Evaluation" name="gb_eval"    context="{'group_by':'evaluation_id'}"/>
                    <filter string="State"      name="gb_state"   context="{'group_by':'state'}"/>
                    <filter string="Month"      name="gb_month"   context="{'group_by':'batch_date:month'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- ================================================================
         PRODUCTION BATCH — Form
    ================================================================ -->
    <record id="view_agx_batch_form" model="ir.ui.view">
        <field name="name">agx.batch.form</field>
        <field name="model">agx.batch</field>
        <field name="arch" type="xml">
            <form string="Production Batch">
                <header>
                    <button name="action_start" string="Start"
                            type="object" class="btn-primary"
                            invisible="state != 'draft'"/>
                    <button name="action_done" string="Mark Done"
                            type="object" class="btn-primary"
                            invisible="state not in ('draft','in_progress')"/>
                    <button name="action_move_to_cold_storage"
                            string="Move to Cold Storage"
                            type="object"
                            invisible="state != 'done'"/>
                    <button name="action_cancel" string="Cancel"
                            type="object"
                            invisible="state == 'cancelled'"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,in_progress,done,cancelled"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button class="oe_stat_button" name="action_view_receipts"
                                type="object" icon="fa-truck"
                                invisible="receipt_count == 0">
                            <field name="receipt_count" widget="statinfo" string="Receipts"/>
                        </button>
                        <button class="oe_stat_button" name="action_view_stock_moves"
                                type="object" icon="fa-exchange"
                                invisible="stock_move_count == 0">
                            <field name="stock_move_count" widget="statinfo" string="Transfers"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="batch_date"/>
                            <field name="evaluation_id"/>
                            <field name="season_id"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                        <group>
                            <field name="input_qty" readonly="1"/>
                            <field name="output_qty" readonly="1"/>
                            <field name="variance_qty" readonly="1"/>
                            <field name="stock_move_state" readonly="1" widget="badge"
                                   decoration-success="stock_move_state == 'done'"
                                   decoration-warning="stock_move_state == 'partial'"
                                   decoration-muted="stock_move_state == 'none'"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Inputs">
                            <field name="input_line_ids">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="product_id"/>
                                    <field name="lot_id"
                                           domain="[('product_id','=',product_id)]"/>
                                    <field name="qty"/>
                                    <field name="uom_id"/>
                                    <field name="note" optional="hide"/>
                                </list>
                            </field>
                        </page>
                        <page string="Outputs">
                            <field name="output_line_ids">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="product_id"/>
                                    <field name="lot_id"/>
                                    <field name="grade_id"/>
                                    <field name="size_id"/>
                                    <field name="qty"/>
                                    <field name="uom_id"/>
                                    <field name="sales_price_unit"/>
                                </list>
                            </field>
                        </page>
                        <page string="Costing">
                            <group string="Cost Inputs">
                                <group>
                                    <field name="manual_raw_material_cost"/>
                                    <field name="manual_operation_cost"/>
                                    <field name="manual_other_cost"/>
                                </group>
                                <group>
                                    <field name="actual_raw_material_cost" readonly="1"/>
                                    <field name="actual_operation_cost" readonly="1"/>
                                    <field name="effective_allocable_cost" readonly="1"/>
                                    <field name="total_relative_sales_value" readonly="1"/>
                                    <field name="costing_status" readonly="1" widget="badge"
                                           decoration-success="costing_status == 'actual'"
                                           decoration-warning="costing_status == 'manual'"/>
                                    <field name="cost_basis_note" readonly="1"/>
                                </group>
                            </group>
                            <separator string="Cost Allocation by Output"/>
                            <field name="output_line_ids" readonly="1">
                                <list>
                                    <field name="product_id"/>
                                    <field name="grade_id"/>
                                    <field name="size_id"/>
                                    <field name="qty"/>
                                    <field name="sales_price_unit"/>
                                    <field name="sales_value" readonly="1"/>
                                    <field name="relative_sales_ratio" readonly="1"
                                           string="Share %"/>
                                    <field name="allocated_cost" readonly="1"/>
                                    <field name="cost_per_unit" readonly="1"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- ================================================================
         GRAPH + PIVOT analytics
    ================================================================ -->
    <record id="view_agx_batch_graph" model="ir.ui.view">
        <field name="name">agx.batch.graph</field>
        <field name="model">agx.batch</field>
        <field name="arch" type="xml">
            <graph string="Production Analysis" type="bar">
                <field name="season_id" type="row"/>
                <field name="output_qty" type="measure"/>
                <field name="effective_allocable_cost" type="measure"/>
            </graph>
        </field>
    </record>

    <record id="view_agx_batch_pivot" model="ir.ui.view">
        <field name="name">agx.batch.pivot</field>
        <field name="model">agx.batch</field>
        <field name="arch" type="xml">
            <pivot string="Production Pivot">
                <field name="season_id" type="row"/>
                <field name="evaluation_id" type="row"/>
                <field name="input_qty" type="measure"/>
                <field name="output_qty" type="measure"/>
                <field name="variance_qty" type="measure"/>
                <field name="effective_allocable_cost" type="measure"/>
            </pivot>
        </field>
    </record>

    <!-- Actions + Menus -->
    <record id="action_agx_batch" model="ir.actions.act_window">
        <field name="name">Production Batches</field>
        <field name="res_model">agx.batch</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="search_view_id" ref="view_agx_batch_search"/>
    </record>
    <menuitem id="menu_agx_batch" name="Production Batches"
              parent="menu_agx_operations"
              action="action_agx_batch" sequence="20"/>

    <record id="action_agx_batch_analysis" model="ir.actions.act_window">
        <field name="name">Production Analysis</field>
        <field name="res_model">agx.batch</field>
        <field name="view_mode">graph,pivot</field>
        <field name="search_view_id" ref="view_agx_batch_search"/>
    </record>

    <record id="action_agx_cost_share_analysis" model="ir.actions.act_window">
        <field name="name">Production Cost Share</field>
        <field name="res_model">agx.batch.output</field>
        <field name="view_mode">graph,pivot</field>
    </record>

    <menuitem id="menu_agx_batch_analysis" name="Production Analysis"
              parent="menu_agx_analytics"
              action="action_agx_batch_analysis" sequence="20"/>
    <menuitem id="menu_agx_cost_share_analysis" name="Production Cost Share"
              parent="menu_agx_analytics"
              action="action_agx_cost_share_analysis" sequence="25"/>

</odoo>
